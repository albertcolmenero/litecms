generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sites     Site[]
  role      Role     @default(ADMIN)
}

enum Role {
  ADMIN
  SUPER_ADMIN
}

model Site {
  id           String   @id @default(cuid())
  name         String
  description  String?
  subdomain    String   @unique
  customDomain String?  @unique
  settings     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pages        Page[]
  assets       Asset[]
  homePageId   String?  @unique
  homePage     Page?    @relation("SiteHomePage", fields: [homePageId], references: [id])
  menus        Menu[]
  forms        Form[]
  blogPosts    BlogPost[]

  @@index([userId])
}

model BlogPost {
  id          String    @id @default(cuid())
  title       String?
  slug        String
  description String?
  content     String?   @db.Text
  image       String?
  author      String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  siteId      String
  site        Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@unique([siteId, slug])
  @@index([siteId])
}

model Page {
  id        String   @id @default(cuid())
  title     String
  slug      String   
  content   String   @db.Text
  description String?
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  siteHomePage Site?  @relation("SiteHomePage")

  menuItems MenuItem[]

  @@unique([siteId, slug])
  @@index([siteId])
}

model Asset {
  id        String   @id @default(cuid())
  key       String
  url       String
  filename  String
  mimeType  String?
  size      Int?
  alt       String?
  createdAt DateTime @default(now())
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@index([siteId])
}

model Menu {
  id        String     @id @default(cuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  siteId    String
  site      Site       @relation(fields: [siteId], references: [id], onDelete: Cascade)
  items     MenuItem[]
  ctas      MenuCta[]
  socialLinks SocialLink[]

  @@index([siteId])
}

model SocialLink {
  id        String   @id @default(cuid())
  platform  String   // e.g., "twitter", "linkedin", "github", "instagram", "facebook", "youtube"
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model MenuItem {
  id        String   @id @default(cuid())
  label     String
  url       String?
  anchor    String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  pageId    String?
  page      Page?    @relation(fields: [pageId], references: [id])

  @@index([menuId])
}

model MenuCta {
  id        String   @id @default(cuid())
  label     String
  url       String
  style     String   @default("primary") 
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  menuId    String
  menu      Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)

  @@index([menuId])
}

model Form {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("waitlist")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  siteId    String
  site      Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  leads     Lead[]

  @@index([siteId])
}

model Lead {
  id        String   @id @default(cuid())
  email     String
  data      Json?
  createdAt DateTime @default(now())
  formId    String
  form      Form     @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId])
}
